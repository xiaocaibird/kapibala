{
  "name": "kapibala-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "npm run dev -w apps/web",
    "dev:simulator": "tsx apps/simulator/src/main.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "build": "npm run typecheck && npm run build -w apps/web",
    "test": "tsx --test tests/**/*.test.ts",
    "verify:original": "tsx scripts/verify-original.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "@fastify/cookie": "11.1.2",
    "@fastify/websocket": "11.3.1",
    "pg": "8.23.0",
    "zod": "4.6.5",
    "ws": "8.22.0",
    "dotenv": "18.0.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "packageManager": "npm@12.1.0"
}
