+      {
+        protocol: "qa-runtime-observation/1",
+        target,
+        ttlMs: 5000,
+        mode: "module-fail-then-hold",
+        correlation: {
+          kind: "module",
+          module: "failing-module",
+          attemptLabel: randomUUID(),
+        },
