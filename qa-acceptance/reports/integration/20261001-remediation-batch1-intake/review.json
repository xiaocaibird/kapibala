  "findings": [
    {
      "id": "INTAKE-R1",
      "classification": "existing-requirement-fix",
      "subject": "CAP009",
      "finding": "Durable awaiting_admission permits retry only before dispatch proof; dispatching and legacy executing remain conservative. Exact recovery, audit reuse, permissions/cancellation and unrelated unknown-effect windows require independent QA retest."
    },
    {
      "id": "INTAKE-R2",
      "classification": "partial-fix-known-remainder",
      "subject": "CAP003",
      "finding": "Model/audit dispatch recalculate budget after durable writes and serialization. Full regression recorded persisted 60005 and interval [60005,60081]; strict 60000ms remains unclosed. Prior contradictory online/active bounds retained, not dismissed or averaged."
    },
    {
      "id": "INTAKE-R3",
      "classification": "test-observation-interface",
      "subject": "message windows",
      "finding": "Three explicit controlled message phases added; per-window database identity and allDatabaseWritersProven=false. Receipt pre-INSERT does not prove global noncommit; post-autocommit hook is not query-unknown commit; no timestamps/results supplied by caller."
    },
    {
      "id": "INTAKE-R4",
      "classification": "startup-target-separation",
      "subject": "capacity vs message entry",
      "finding": "Message entry installs only testMessageObserver; capacity entry is separate. Distinct frozen targets/authorizations are required; no QA-only business-hook composition or claim of concurrent capabilities."
    },
    {
      "id": "INTAKE-R5",
      "classification": "remaining-integration-dependency",
      "subject": "runtime observation",
      "finding": "Account/module/activity runtime observation is absent from this candidate. Existing four runtime cases remain dependent; no fake capability or exclusion from business denominator."
    },
    {
      "id": "INTAKE-R6",
      "classification": "evidence-scope",
      "subject": "developer vs QA",
      "finding": "438 tests ran 6d5f; only final protocol capability delta has exact ffdc focused 5-test evidence. Logging known limitation as expected is not original requirement satisfaction. Cleanup is developer-record evidence only, not independently re-executed here."
