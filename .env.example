PORT=3100
DATABASE_URL=postgres://kapibala:kapibala@localhost:55432/kapibala
GATEWAY_URL=http://127.0.0.1:3101
AGENT_URL=http://127.0.0.1:3102
AGENT_TURN_TIMEOUT_MS=12000
# C1: dedicated, persistent local directory (all instances of one DB must share it).
MEDIA_DIR=media
MEDIA_RETENTION_DAYS=30
MEDIA_MAX_BYTES=20971520
MEDIA_DOWNLOAD_TIMEOUT_MS=15000
MEDIA_CLEANUP_INTERVAL_MS=3600000

# C2 optional independent Gemini Agent (never commit a real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_AGENT_PORT=0
GEMINI_SESSION_DIR=.runtime/gemini-agent
# Optional: read only key fields from an existing local .env
# GEMINI_ENV_FILE=/absolute/path/to/main-workspace/.env
